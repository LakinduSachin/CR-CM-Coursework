        "# Labelled 2-D PCA views of the four solutions. The caption notes PCA can hide separation.\n",
        "def pca_plot(ax, X, labels, title):\n",
        "    p = PCA(n_components=2, random_state=RANDOM_SEED)\n",
        "    xy = p.fit_transform(X)\n",
        "    d = pd.DataFrame(xy, index=X.index, columns=[\"PC1\", \"PC2\"]); d[\"Cluster\"] = labels.astype(str).values\n",
        "    sns.scatterplot(data=d, x=\"PC1\", y=\"PC2\", hue=\"Cluster\", palette=\"tab10\", s=30, ax=ax)\n",
        "    ax.set_title(title)\n",
        "    ax.set_xlabel(f\"PC1 ({p.explained_variance_ratio_[0]:.0%})\")\n",
        "    ax.set_ylabel(f\"PC2 ({p.explained_variance_ratio_[1]:.0%})\")\n",
        "\n",
        "fig, axes = plt.subplots(2, 2, figsize=(13, 10))\n",
        "pca_plot(axes[0,0], X_risk, ward_risk, \"Risk-return - Ward\")\n",
        "pca_plot(axes[0,1], X_risk, km_risk, \"Risk-return - K-means\")\n",
        "pca_plot(axes[1,0], X_rfm, ward_rfm, \"RFM - Ward\")\n",
        "pca_plot(axes[1,1], X_rfm, km_rfm, \"RFM - K-means\")\n",
        "plt.tight_layout(); plt.show()"
