        "# 1.4.1 Recency: for each share find its latest event on/before the observation date.\n",
        "events_to_date = high_volume_events.loc[:observation_date]\n",
        "\n",
        "def latest_event(col):\n",
        "    hits = col[col].index\n",
        "    return hits.max() if len(hits) else pd.NaT\n",
        "\n",
        "latest_event_dates = events_to_date.apply(latest_event)\n",
        "# Calendar-day difference; NaT (no event) becomes NaN, which I keep rather than turning into zero.\n",
        "recency = (observation_date - latest_event_dates).dt.days\n",
        "\n",
        "# 1.4.2 Frequency: count the events inside the last 60 sessions.\n",
        "frequency = high_volume_events.loc[last_60_dates].sum()\n",
        "\n",
        "# 1.4.3 Monetary: sum Close x Volume over the last 60 sessions (min_count=60 keeps only full windows).\n",
        "monetary = (close * volume).loc[last_60_dates].sum(min_count=60)\n",
        "\n",
        "rfm = pd.DataFrame({\"Recency\": recency, \"Frequency\": frequency, \"Monetary\": monetary})\n",
        "print(\"Shares with no event (Recency is NaN):\", int(rfm.Recency.isna().sum()))\n",
        "rfm.head()"
      ],
