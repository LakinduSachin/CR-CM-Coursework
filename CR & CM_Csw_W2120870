        "# Elbow + silhouette curves for both matrices.\n",
        "fig, axes = plt.subplots(2, 2, figsize=(13, 8))\n",
        "for ax, tbl, col, title in [\n",
        "    (axes[0,0], km_risk_scores, \"Inertia\", \"Risk-return - inertia\"),\n",
        "    (axes[0,1], km_risk_scores, \"Silhouette\", \"Risk-return - silhouette\"),\n",
        "    (axes[1,0], km_rfm_scores, \"Inertia\", \"RFM - inertia\"),\n",
        "    (axes[1,1], km_rfm_scores, \"Silhouette\", \"RFM - silhouette\")]:\n",
        "    ax.plot(tbl.index, tbl[col], marker=\"o\"); ax.set(title=title, xlabel=\"k\", ylabel=col)\n",
        "plt.tight_layout(); plt.show()\n",
        "\n",
        "# Fit K-means at the same counts I chose for Ward, so the two algorithms compare on equal footing.\n",
        "km_risk = pd.Series(KMeans(n_clusters=K_RISK, random_state=RANDOM_SEED, n_init=50).fit_predict(X_risk),\n",
        "                    index=common, name=\"KMeans_Risk\")\n",
        "km_rfm  = pd.Series(KMeans(n_clusters=K_RFM, random_state=RANDOM_SEED, n_init=50).fit_predict(X_rfm),\n",
        "                    index=common, name=\"KMeans_RFM\")"
