        "# One dendrogram per matrix. The parentheses on each leaf show how many shares it holds.\n",
        "fig, axes = plt.subplots(1, 2, figsize=(15, 5))\n",
        "for ax, X, title in [(axes[0], X_risk, \"Ward dendrogram - risk and return\"),\n",
        "                     (axes[1], X_rfm, \"Ward dendrogram - RFM activity\")]:\n",
        "    Z = linkage(X.to_numpy(), method=\"ward\")\n",
        "    dendrogram(Z, truncate_mode=\"lastp\", p=30, show_leaf_counts=True, leaf_rotation=90, ax=ax)\n",
        "    ax.set_title(title); ax.set_xlabel(\"leaf group (shares in parentheses)\"); ax.set_ylabel(\"Ward merge distance\")\n",
        "plt.tight_layout(); plt.show()"
